---
interface Props {
  onlineHint?: boolean
  allOperational: boolean
  monitorCount: number
}

const { onlineHint = true, allOperational, monitorCount } = Astro.props

const title = allOperational ? 'All systems operational' : 'Some monitors need attention'
const subtitle = onlineHint
  ? `${monitorCount} local monitors loaded`
  : `${monitorCount} local monitors loaded • weak offline hint active`
---

<section class="app-panel p-6">
  <div class="flex items-start gap-4">
    <div
      class:list={[
        'grid size-11 place-items-center rounded-full',
        allOperational
          ? 'bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/20'
          : 'bg-amber-500/15 text-amber-400 ring-1 ring-amber-500/20',
      ]}
    >
      <svg viewBox="0 0 24 24" class="size-6 fill-current" aria-hidden="true">
        <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm-1 14-4-4 1.4-1.4 2.6 2.6 5.6-5.6L18 9Z" />
      </svg>
    </div>

    <div class="min-w-0">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-100">{title}</h2>
      <p class="mt-2 text-sm text-slate-400">{subtitle}</p>

      <div class="mt-4 flex flex-wrap gap-2">
        <span class="metric-pill">PWA ready</span>
        <span class="metric-pill">Offline shell</span>
        <span class="metric-pill">Rolling bars</span>
        <span class="metric-pill">Local-only data</span>
      </div>
    </div>
  </div>
</section>
