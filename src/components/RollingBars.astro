---
import type { ProbeSample } from '../lib/types'

interface Props {
  samples: ProbeSample[]
}

const { samples } = Astro.props

function barClass(state: ProbeSample['state']) {
  if (state === 'up') return 'bg-emerald-400'
  if (state === 'degraded') return 'bg-amber-400'
  if (state === 'down') return 'bg-rose-500'
  if (state === 'blocked') return 'bg-violet-400'
  return 'bg-slate-600'
}
---

<div class="min-w-0">
  <div class="flex items-center justify-end gap-[5px] overflow-hidden">
    {samples.map((sample) => (
      <div
        class:list={[
          'h-7 w-[7px] flex-none rounded-full shadow-[0_0_0_1px_rgba(255,255,255,0.04)]',
          barClass(sample.state),
        ]}
        title={`${sample.state}${sample.latencyMs ? ` • ${sample.latencyMs}ms` : ''}`}
      />
    ))}
  </div>

  <div class="mt-2 flex justify-between text-xs text-slate-500">
    <span>{samples.length} samples ago</span>
    <span>now</span>
  </div>
</div>
